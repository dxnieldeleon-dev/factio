# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Supabase - Client / Vite
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Facturama - Server only
FACTURAMA_USERNAME=
FACTURAMA_PASSWORD=
FACTURAMA_ENV=sandbox

# Sentry
# Client-side DSN (safe to expose). Leave empty to disable Sentry.
VITE_SENTRY_DSN=
# Server-side DSN (worker runtime). Usually the same value as above.
SENTRY_DSN=
